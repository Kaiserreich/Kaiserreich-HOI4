@GROUP_WIDTH = 500
@GROUP_HEIGHT = 105

@POINTS_X = 26
@POINTS_Y = 69
@POINTS_WIDTH = 32
@POINTS_HEIGHT = 32
@POINTS_TEXT_X = 5
@POINTS_TEXT_Y = 6
@POINTS_TEXT_WIDTH = 25
@POINTS_TEXT_HEIGHT = 10

@POINTS_BUTTON_X = 22
@POINTS_BUTTON_Y = 100

guiTypes = {

	containerWindowType = {
		name = "yugoslavia_decision_cat_gui"
		position = { x = 0 y = 5 }
		size = { width = 100% height = 130 }

		containerWindowType = {
			name = "SER_yugoslavia_ethnicities_container"
			size = { width = 100% height = 100% }
			position = { x = 15 y = 0 }
			background = {
				name = "Background"
				spriteType ="GFX_tiled_window_transparent"
				alwaystransparent = yes
			}
			gridboxtype = {
				name = "SER_yugoslavia_ethnicity_grid"
				position = { x = 0 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 100 height = 100 }
				#slotsize = { width = 500 height = 100 }
				max_slots_horizontal = 5
				format = "UPPER_LEFT"
			}
		}
	}

	containerWindowType = {
		name = "SER_yugoslavia_ethnicity_entry"
		position = { x = 0 y = 5 }
		size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

		iconType = {
			name = "SER_yugoslavia_ethnicity_icon"
			position = { x = 0 y = 0 }
			spriteType = "GFX_goal_serbia"
			pdx_tooltip = YUG_ethnicity_tooltip
			pdx_tooltip_delayed = YUG_ethnicity_tooltip_desc
		}

		containerWindowType = {
			name = "SER_yugoslavia_ethnicity_icon_points"
			position = { x = @POINTS_X y = @POINTS_Y }
			size = { width = @POINTS_WIDTH height = @POINTS_HEIGHT }
			iconType = {
				name = "background"
				spriteType = "GFX_raid_type_background_round"
				pdx_tooltip = YUG_ethnicity_tooltip_points_desc_tooltip
			}
			instantTextBoxType = {
				name = "SER_yugoslavia_ethnicity_icon_value"
				position = { x = @POINTS_TEXT_X y = @POINTS_TEXT_Y }
				font = "hoi_18mbs"
				text = YUG_ethnicity_tooltip_points_tooltip
				maxWidth = @POINTS_TEXT_WIDTH
				maxHeight = @POINTS_TEXT_HEIGHT
				fixedsize = yes
				format = center
				alwaystransparent = yes
			}
		}

		buttonType = {
			name = "SER_yugoslavia_ethnicity_button"
			position = { x = @POINTS_BUTTON_X y = @POINTS_BUTTON_Y }
			format = left
			quadTextureSprite = "GFX_decision_select_icon_strip"
			pdx_tooltip = SER_yugoslavia_ethnicity_button_tooltip
			clicksound = click_checkbox
			frame = 2
		}
	}
}
