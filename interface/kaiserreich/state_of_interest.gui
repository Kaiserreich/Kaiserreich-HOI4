@soi_icon_x_pos = 55
@soi_icon_y_pos = 18
@soi_text_x_pos = 80
@soi_text_y_pos = -4

guiTypes = {
	containerWindowType = {
		name = "KR_state_of_interest"

		iconType = {
			name = "KR_state_of_interest_header"
			spriteType = GFX_state_of_interest_header
			position = { x = 0 y = -11 }
			alwaystransparent = yes
		}

		iconType = {
			name = "KR_state_of_interest_icon"
			spriteType = "GFX_empty_paper"
			position = { x = 40  y = 18 } #default. modify in scripted GUI
			centerposition = yes
			pdx_tooltip = KR_state_of_interest_icon_tooltip
			pdx_tooltip_delayed = KR_state_of_interest_icon_tooltip_delayed
		}

		instantTextBoxType = {
			name = "KR_state_of_interest_state_name"
			text = KR_state_of_interest_state_name_text
			font = hoi_36header
			format = center

			position = { x = @soi_text_x_pos  y = @soi_text_y_pos }
			maxWidth = 330
			maxHeight = 30
		}

		instantTextBoxType = {
			name = "KR_state_of_interest_state_title"
			text = KR_state_of_interest_state_title_text
			font = hoi_24header
			format = center

			position = { x = @soi_text_x_pos  y = 20 }
			maxWidth = 330
			maxHeight = 30
		}
	}
}

